{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./**/*.vue",
    "env.d.ts"
  ],
  "exclude": [
    "dist",
    "vite.config.ts"
  ],
  "compilerOptions": {
    "types": [
      "unplugin-vue-macros/macros-global"
    ],
    "lib": [
      "ESNext",
      "DOM"
    ],
    "noEmit": false,
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "rootDir": "./",
    "outDir": "dist",
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false
  }
}